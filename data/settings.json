  "stuck_threshold": 3,
  "web_search_engine": "baidu",
  "web_search_timeout": 10,
  "memory_enabled": true,
  "memory_max_context": 200,
  "mem_engram_count": 16,
  "mem_engram_slots": 200,
  "todo_enabled": true,
  "todo_max_context": 200,
  "mcp_enabled": true,
  "mcp_connect_timeout": 10,
  "mcp_request_timeout": 60,
  "daemon_port": 9655,
  "subproc_max": 4,
  "cache_enabled": true,
  "cache_msg_tail": 4,
  "cache_probe_max_misses": 3,
  "cache_probe_reprobe": 2,
  "cache_api_support": "",
  "trace_enabled": "1",
  "trace_max_frames": 1000,
  "trace_snapshot_interval": 50,
  "trace_prune_keep": 200,
  "mcp_servers": {}
