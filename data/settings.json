{
  "api_url": "https://api.deepseek.com/v1/chat/completions",
  "model": "deepseek-v4-pro",
  "max_tokens": 384000,
  "thinking_budget": 100000,
  "api_protocol": "auto",
  "connect_timeout": 10,
  "cmd_timeout": 300,
  "compress_threshold": 250000,
  "show_thinking": "status",
  "auth_header": "",
